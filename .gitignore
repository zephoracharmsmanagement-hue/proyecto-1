# Secretos — NUNCA subir a git.
# El token de Meta vive aquí y solo aquí.
.env
.env.*
!.env.example

# Reportes generados por los scripts de meta/
meta/salida/

# Exportaciones de WhatsApp — datos personales de clientas.
# Traen nombres, teléfonos y direcciones de entrega: no van a git ni a
# ningún repositorio remoto. Se analizan localmente y lo que sale de ahí
# son conclusiones agregadas, nunca conversaciones textuales.
insumos/whatsapp/*
!insumos/whatsapp/README.md

# El Excel de inventario trae costo unitario y margen por pieza — información
# financiera interna. Lo que sale de cruzarlo (data/stock.json) sí se versiona:
# solo tiene disponibilidad, nunca costos.
insumos/*.xlsx
insumos/*.xls

node_modules/
.DS_Store
