# Copia este archivo a .env y llena los valores.
#
#   cp .env.example .env
#
# .env está en .gitignore y NO se sube a git. No lo pegues en chats,
# capturas, ni issues.

# Token de acceso de Meta. Genéralo en:
#   business.facebook.com → Configuración del negocio → Usuarios del sistema
# Prefiere un usuario del sistema con permisos acotados sobre un token
# personal con permisos totales.
META_ACCESS_TOKEN=

# Versión de la Graph API.
# Meta retira cada versión ~2 años después de publicarla. v19.0 expiró el
# 21 de mayo de 2026 y v18.0 el 26 de enero de 2026; la vigente es v25.0
# (publicada el 18 de febrero de 2026). Si ves errores de "unsupported
# version", sube este número.
META_API_VERSION=v25.0

# Opcionales: si los llenas, los scripts dejan de preguntar.
# El ID de cuenta publicitaria va con el prefijo act_.
META_AD_ACCOUNT_ID=

# Hay DOS píxeles y usan cada uno su vía, así que este valor NO es el mismo
# en tu máquina que en Netlify:
#
#   2130673404542988  «pixel 1», el viejo. Vive en una cuenta publicitaria
#                     sin portafolio comercial dueño. Es el que las campañas
#                     y los públicos leen, y el que miran los scripts de
#                     meta/. NUNCA podrá tener Conversions API: Meta exige
#                     ser admin del portafolio que lo posee, y no tiene uno.
#
#   1029982529813994  «pixel web», el nuevo, dentro del portafolio «Zephora
#                     Charms». Es el único al que se le puede generar token
#                     de CAPI, así que es el que tiene que estar puesto en
#                     Netlify para que el Purchase de servidor llegue.
#
# Aquí queda el viejo porque esta variable, en tu máquina, la leen los
# scripts de meta/. En Netlify tiene que valer el NUEVO. Ver ESTADO.md § 4a.
META_PIXEL_ID=2130673404542988

# ── Conversions API ──────────────────────────────────────────────────────
# OJO: estas dos NO van aquí para que las lea tu máquina. Van en Netlify →
# Site configuration → Environment variables, porque quien las usa es
# netlify/functions/_meta.js, que corre en el servidor. Se documentan aquí
# para que se sepa que existen.

# Token de la Conversions API. Es DISTINTO del META_ACCESS_TOKEN de arriba:
# se genera en Events Manager → dataset 1029982529813994 (el NUEVO; en el
# viejo la opción no existe) → Configuración → Conversions API → Generar
# token de acceso.
#
# El token queda atado al píxel donde se generó. Si META_PIXEL_ID en Netlify
# apunta a otro, Meta responde 400 y no se manda nada: los dos valores tienen
# que hablar del mismo píxel.
#
# Falla en silencio por diseño —un pago aprobado nunca se cae porque Meta no
# conteste—, así que no vas a notarlo mirando la tienda. Se comprueba en los
# logs de la función, buscando la línea «meta_purchase»: `enviado:false` y el
# `motivo` dicen qué pasó («sin configurar» = falta este token). El otro sitio
# donde se ve es Events Manager: si el píxel nuevo no tiene eventos de
# servidor, esto no está llegando.
META_CAPI_TOKEN=

# Mientras esto tenga valor, los eventos van SOLO al panel «Probar eventos»
# de Meta y NO cuentan como conversiones. Se pone para la primera prueba y
# SE QUITA después: si se queda puesto, ninguna compra real llega a la pauta.
# El código lo da Events Manager → Probar eventos.
META_TEST_EVENT_CODE=
